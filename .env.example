SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE=
# Unused in this MVP. /admin is open and does not read ADMIN_SECRET.
# Set it again only after the PIN check in api/admin/session.js is restored.
# ADMIN_SECRET=
GOOGLE_SITE_VERIFICATION=

# /api/chat — proxy do Corvo para o Quest (a chave nunca vai no APK).
# Groq: basta GROQ_API_KEY. Para Qwen em servidor próprio (Ollama/LM Studio/vLLM por túnel),
# defina LLM_BASE_URL (ex. https://seu-tunel.example/v1) e LLM_MODEL (ex. qwen3:8b).
GROQ_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b
# Opcional: exige o header x-genjutsu-token. Freia uso casual do endpoint aberto.
# CHAT_PROXY_TOKEN=
